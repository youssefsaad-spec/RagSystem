{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "qwen3-embedding:0.6b",
    "EmbeddingDimensions": 1024,
    "EmbeddingOnCpu": false,
    "TimeoutSeconds": 120
  },
  "Chunking": {
    "MaxTokensPerChunk": 500,
    "MaxTokensPerLine": 500,
    "OverlapTokens": 100
  }
}
