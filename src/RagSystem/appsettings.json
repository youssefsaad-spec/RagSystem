{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Embeddings": {
    "Provider": "Gemini"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "qwen3-embedding:0.6b",
    "EmbeddingDimensions": 1024,
    "EmbeddingOnCpu": false,
    "TimeoutSeconds": 120
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiKey": "",
    "ChatModel": "gemini-3.1-flash-lite",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingDimensions": 1024,
    "RewriteModel": "gemini-3.1-flash-lite",
    "Temperature": 0.3,
    "MaxOutputTokens": 3000,
    "ThinkingBudget": 0,
    "ChatRetries": 2,
    "RetryDelaySeconds": 2,
    "TimeoutSeconds": 120
  },
  "Chat": {
    "MaxConcurrentGenerations": 1,
    "ChatTimeoutSeconds": 60,
    "RewriteTimeoutSeconds": 10,
    "HistoryMaxTurns": 6,
    "HistoryMaxTokens": 2000,
    "RewriteHistoryTurns": 3,
    "RewriteMaxOutputTokens": 300
  },
  "Retrieval": {
    "TopK": 20,
    "MinScore": 0.60,
    "DuplicateSimilarity": 0.95,
    "ContextBudgetTokens": 5000
  },
  "LangSmith": {
    "Enabled": true,
    "Endpoint": "https://api.smith.langchain.com/otel",
    "ApiKey": "",
    "Project": "ragsystem",
    "WorkspaceId": "",
    "ServiceName": "ragsystem",
    "CaptureContent": true
  },
  "Chunking": {
    "MaxTokensPerChunk": 500,
    "MaxTokensPerLine": 500,
    "OverlapTokens": 100
  }
}
