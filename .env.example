# Copy this file to ".env" (next to docker-compose.yml) and change the values. ".env" is git-ignored; this example is committed,
# so it holds names and harmless local defaults only, never a real secret.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=ragsystem
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ragsystem

# --- Ollama (read by docker-compose.yml; only needed when Embeddings__Provider=Ollama, the default is Gemini) ---
Ollama__EmbeddingModel=qwen3-embedding:0.6b

# --- The app itself does NOT read this file ---
# `dotnet run` reads appsettings*.json and the real environment. For anything but local use, set these in the shell or the host:
#   ConnectionStrings__Db   Host=localhost;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>
#   Gemini__ApiKey          the Gemini API key (read by the app; the chat client is F20, not built yet); never put it in appsettings.json
#                           Locally you can use instead: dotnet user-secrets set "Gemini:ApiKey" "<key>" --project src/RagSystem
#   Admin__ApiKey           (F29, not built yet) the first admin key
